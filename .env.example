# Copie para .env e preencha os valores reais (nunca commite o .env):
#   copy .env.example .env          # Windows
#   cp .env.example .env            # macOS / Linux
#
# Nomes alinhados ao contrato .doctrina/contracts/mobile-test-runtime.md
# e à ADR 0004 (secrets via dotenv).

# --- Runtime Robot (também podem vir de -v no CLI / makefile) ---
PLATFORM_NAME=android
ENVIRONMENT=local

# --- App local ---
PATH_VERSIONS=
APPIUM_SERVER_LOCAL=http://127.0.0.1:4723
ANDROID_APP_LOCAL=app-cert-release.apk
IOS_APP_LOCAL=Runner.app

# --- BrowserStack App Automate ---
APPIUM_SERVER_BS=https://hub-cloud.browserstack.com/wd/hub
PROJECT_NAME_BS=B3_APP
BUILD_BS=REGRESSION_ANDROID
USERNAME_BS=
ACESSKEY_BS=
APP_ANDROID_BS=bs://
APP_IOS_BS=bs://

# --- Serviços auxiliares ---
MAILSAC_URL=https://mailsac.com/api
MAILSAC_TOKEN=

# --- Makefile (opcional; default no makefile é regressivo) ---
TAGS=regressivo
