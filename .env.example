# Copie para .env e preencha os valores reais (nunca commite o .env):
#   copy .env.example .env          # Windows
#   cp .env.example .env            # macOS / Linux
#
# Nomes alinhados ao contrato .doctrina/contracts/mobile-test-runtime.md
# e à ADR 0004 (secrets via dotenv).

# --- Runtime Robot (também podem vir de -v no CLI / makefile) ---
PLATFORM_NAME=android
ENVIRONMENT=local

# --- App local ---
PATH_VERSIONS=
APPIUM_SERVER_LOCAL=http://127.0.0.1:4723
ANDROID_APP_LOCAL=app-cert-release.apk
IOS_APP_LOCAL=Runner.app

# --- BrowserStack App Automate ---
APPIUM_SERVER_BS=https://hub-cloud.browserstack.com/wd/hub
PROJECT_NAME_BS=Automacao APP B3i
# BUILD_NUMBER (CI) tem prioridade; senão BUILD_BS; senão local-YYYYMMDD-HHmmss
BUILD_NUMBER=
BUILD_BS=
USERNAME_BS=
ACESSKEY_BS=
APP_ANDROID_BS=
APP_IOS_BS=

# SSL corporativo (proxy/inspeção). Preferir CA da empresa; senão BS_SSL_VERIFY=false
# BS_CA_BUNDLE=C:\certs\corp-root.pem
BS_SSL_VERIFY=true

# Device livre (opção B) — evita em paralelo multi-plataforma; prefira as chaves por OS
DEVICE_NAME_BS=
PLATFORM_VERSION_BS=
# Paralelo Android+iOS: use estes (não DEVICE_NAME_BS genérico)
DEVICE_NAME_ANDROID_BS=
PLATFORM_VERSION_ANDROID_BS=
DEVICE_NAME_IOS_BS=
PLATFORM_VERSION_IOS_BS=

# Flags bstack:options (default true se vazio)
BS_DEBUG=true
BS_NETWORK_LOGS=true
BS_APP_PROFILING=true
APPIUM_VERSION_BS=2.12.1

# --- Serviços auxiliares ---
MAILSAC_URL=https://mailsac.com/api
MAILSAC_TOKEN=

# --- Squad Projects API (teste de integração) ---
SQUAD_PROJECTS_API_URL=http://localhost:3000
SQUAD_PROJECTS_PROJECT_ID=75

# --- Makefile (opcional; default no makefile é regressivo) ---
TAGS=regressivo
